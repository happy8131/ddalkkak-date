# 백엔드 API 기본 주소 (브라우저에서 호출)
NEXT_PUBLIC_API_BASE_URL=http://localhost:8080

# Sentry (KAN-56). DSN이 비어 있으면 SDK가 꺼져서 아무것도 전송하지 않는다.
# 로컬에서 연동을 확인할 때만 .env.local에 넣고, 환경 이름을 prod와 구분한다
# NEXT_PUBLIC_SENTRY_DSN=
# NEXT_PUBLIC_SENTRY_ENVIRONMENT=local
# NEXT_PUBLIC_SENTRY_TRACES_SAMPLE_RATE=0.1
# 소스맵 업로드는 배포 워크플로(KAN-57)에서만 동작한다: SENTRY_ORG, SENTRY_PROJECT, SENTRY_AUTH_TOKEN, SENTRY_RELEASE
