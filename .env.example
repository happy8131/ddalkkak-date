# docker compose가 읽는 로컬 개발용 환경 변수. 복사해서 .env로 만들어 사용한다 (.env는 커밋하지 않는다).
# 모두 기본값이 있어서 .env 없이도 `docker compose up`이 동작한다.

# --- DB ---
POSTGRES_DB=ddalkkak
POSTGRES_USER=ddalkkak
POSTGRES_PASSWORD=ddalkkak

# --- 호스트 포트 (충돌 시 변경) ---
# 호스트에 설치된 PostgreSQL이 5432를 쓰는 경우를 피하려고 5433을 기본으로 한다
POSTGRES_HOST_PORT=5433
BACKEND_HOST_PORT=8080
FRONTEND_HOST_PORT=3000

# --- 외부 API 키 (placeholder, 아직 코드에서 사용하지 않음) ---
# 실제 값은 .env에만 넣고 절대 커밋하지 않는다
KAKAO_REST_API_KEY=your-kakao-rest-api-key
NAVER_CLIENT_ID=your-naver-client-id
NAVER_CLIENT_SECRET=your-naver-client-secret
ANTHROPIC_API_KEY=your-anthropic-api-key
